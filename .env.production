# 请在服务器上创建 .env 文件并填入您的配置

# ========== 数据库配置 ==========
DB_HOST=127.0.0.1
DB_PORT=3306
DB_NAME=oldz
DB_USER=oldz
DB_PASSWORD=your_db_password

# ========== JWT 配置（必需，请使用随机字符串）==========
JWT_SECRET=please_generate_a_random_secret_at_least_32_chars

# ========== CORS 白名单 ==========
CORS_ORIGINS=https://your-domain.com,http://localhost:5173

# ========== API 地址 ==========
# 部署前端到生产服务器时，通常使用 nginx 反向代理，填 /api 即可
# 如果是 Capacitor 打包的原生 App，需要填完整的远程地址
VITE_API_BASE_URL=http://localhost:3001/api

# ========== 本地模式在线同步 ==========
# 默认复用 VITE_API_BASE_URL；桌面本地 API 与在线 API 分离时设置为真正的在线后端。
# 桌面端用户无需也不能自行填写服务器地址。
OLDZ_CLOUD_API_BASE_URL=https://your-domain.com/api

# ========== 服务端口 ==========
PORT=3001

# ========== 阿里云 OSS 配置（后端使用，不暴露给前端）==========
OSS_REGION=oss-cn-hangzhou
OSS_ACCESS_KEY_ID=your_access_key_id
OSS_ACCESS_KEY_SECRET=your_access_key_secret
OSS_BUCKET=old-z-files
