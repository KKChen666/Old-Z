# 请复制此文件为 .env 并填入您的配置

# ========== 数据库配置 ==========
DB_HOST=127.0.0.1
DB_PORT=3306
DB_NAME=oldz
DB_USER=oldz
DB_PASSWORD=your_db_password

# ========== JWT 配置（必需，不设置则服务无法启动）==========
# 请使用随机字符串，至少 32 位
JWT_SECRET=your_random_jwt_secret_at_least_32_chars_long

# ========== CORS 白名单 ==========
# 允许的前端域名，逗号分隔
CORS_ORIGINS=http://localhost:5173,http://localhost:3000,http://localhost:8080

# ========== API 地址 ==========
# 前端直连 API 时使用（Capacitor 原生 App / Electron 生产模式）
# 浏览器 dev 模式无需配置，Vite 代理自动转发 /api → localhost:PORT
VITE_API_BASE_URL=http://localhost:3001/api

# ========== 本地模式在线同步 ==========
# 默认直接复用上面的 VITE_API_BASE_URL；仅在桌面本地 API 与在线 API 分离时覆盖此项。
# 地址由部署方配置，不在同步页面中填写；生产环境必须使用 HTTPS。
OLDZ_CLOUD_API_BASE_URL=https://your-domain.com/api

# ========== 服务端口 ==========
PORT=3001

# ========== 阿里云 OSS 配置（后端使用，不暴露给前端）==========
# 未配置时文件上传将回退到 base64（限 2MB）
OSS_REGION=oss-cn-hangzhou
OSS_ACCESS_KEY_ID=your_access_key_id
OSS_ACCESS_KEY_SECRET=your_access_key_secret
OSS_BUCKET=old-z-files
